radareleitoral.dominiodigital.dev.br {
    header {
        # Oculta assinatura e versao de servidores internos
        -Server
        -Via

        # Protecoes OWASP de Borda
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    reverse_proxy painel:8501
}

eleicao.dominiodigital.dev.br {
    # Redirecionamento permanente (301) do domínio anterior para a nova marca oficial
    redir https://radareleitoral.dominiodigital.dev.br{uri} permanent
}

:80 {
    # Redireciona qualquer chamada HTTP ou por IP direto para o domínio seguro HTTPS
    redir https://radareleitoral.dominiodigital.dev.br{uri} permanent
}

