*.py[cod]
*$py.class
.venv/
venv/
env/

# Banco de dados SQLite e Cache Parquet de grande porte (>100MB excede limite do GitHub)
# Banco de dados SQLite e Cache Parquet de grande porte (>100MB excede limite do GitHub)
